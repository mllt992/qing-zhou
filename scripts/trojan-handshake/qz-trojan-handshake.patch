+// interruptHandshake ends only this connection or stream. Deadline-capable
+// conns (TCP, TLS, HTTPUpgrade, QUIC streams) get an immediate read deadline;
+// existing deadlines are never extended or cleared. Other conns (WebSocket,
+// HTTP/2, gRPC lite) are closed through their own per-stream Close, which never
+// closes a shared session. The WebSocket close frame write is bounded by that
+// transport's own write deadline.
+func interruptHandshake[K comparable](conn net.Conn, resultCh <-chan handshakeResult[K], cause error) error {
+	if conn.SetReadDeadline(time.Now()) != nil {
+		conn.Close()
+	}
+	grace := time.NewTimer(interruptGrace)
+	defer grace.Stop()
+	select {
+	case <-resultCh:
+	case <-grace.C:
 	}
+	return E.Cause(cause, "read trojan request")
