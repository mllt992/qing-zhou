+// readHandshake reads exactly the request header; bytes after it stay unread.
+// An unknown key stops before the tail so fallback receives it unchanged.
+func (s *Service[K]) readHandshake(conn net.Conn) (result handshakeResult[K]) {
+	reader := &handshakeReader{Reader: conn}
+	result.keyRead, result.keyErr = readKey(reader, result.key[:])
+	if result.keyErr != nil {
