+// readKey fills key exactly. It returns errBadKeyFormat as soon as a byte
+// cannot belong to any Trojan key, io.EOF for EOF (n reports consumed bytes)
+// and other read errors unchanged.
+func readKey(reader io.Reader, key []byte) (int, error) {
+	var n int
+	for n < len(key) {
+		m, err := reader.Read(key[n:])
+		for _, c := range key[n : n+m] {
+			if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+				return n + m, errBadKeyFormat
+			}
+		}
+		n += m
+		if n == len(key) {
+			return n, nil
+		}
+		if err != nil {
+			if errors.Is(err, io.ErrUnexpectedEOF) {
+				err = io.EOF
+			}
+			return n, err
+		}
+	}
+	return n, nil
+}
